{
  "name": "sparkbench",
  "version": "0.1.0",
  "description": "Circuit design and simulation with KiCad integration",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"npm:dev:electron\"",
    "dev:electron": "npm run build:electron && wait-on tcp:5183 && cross-env VITE_DEV_SERVER_URL=http://localhost:5183 electron .",
    "dev:web": "vite",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron",
    "build": "tsc -p . && vite build && npm run build:electron",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:dir": "npm run build && electron-builder --win dir --x64"
  },
  "author": {
    "name": "kingrebelf"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eecircuit-engine": "^1.9.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "immer": "^11.2.9",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "homepage": "https://github.com/kingrebelf/Spark-bench",
  "build": {
    "appId": "com.kingrebelf.sparkbench",
    "productName": "SparkBench",
    "copyright": "Copyright (c) 2026 kingrebelf",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SparkBench",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
