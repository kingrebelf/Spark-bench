{
  "format": "sparkbench-project",
  "version": 1,
  "meta": {
    "name": "Half-wave rectifier with smoothing",
    "created": "2026-10-28T00:00:00.000Z",
    "modified": "2026-10-28T00:00:00.000Z",
    "appVersion": "0.1.0",
    "description": "10 V peak, 50 Hz through a 1N4007-like diode into 100 µF and a 1 kΩ load. The capacitor holds the peak (≈ 9.2 V) and sags ≈ 1.8 V between peaks (ripple ≈ I/(f·C))."
  },
