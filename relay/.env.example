# Fine-grained personal access token: Repository access "Only select repositories" -> Spark-bench,
# Permissions -> Repository -> Issues: Read and write. Nothing else.
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=kingrebelf/Spark-bench
PORT=8787
# 1 only when a reverse proxy you control sets X-Forwarded-For (nginx, Fly, Render, Cloud Run).
TRUST_PROXY=1
RATE_PER_IP=5
RATE_PER_IP_WINDOW_MIN=10
RATE_GLOBAL_PER_HOUR=60
MAX_BODY_KB=128
